# ChatterPal application configuration
# Copy to .env in the repository root; see docs/deployment.md for installation.
# Process environment variables override .env. Only Settings-backed keys belong here.
# Unknown keys in older/shared .env files are ignored; they do not enable features.

# Default stack: local Whisper ASR + Edge TTS + Alibaba DashScope LLM.
# Fill in this key before using Alibaba LLM/TTS. No ASR secret is needed.
DASHSCOPE_API_KEY=
LLM_PROVIDER=alibaba
ALIBABA_MODEL=qwen-plus
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MAX_TOKENS=2000
ALIBABA_TEMPERATURE=0.7
ALIBABA_TOP_P=0.8
ALIBABA_ENABLE_SEARCH=false

# Legacy DashScope key alias; DASHSCOPE_API_KEY takes precedence when both are set.
# ALIBABA_API_KEY=

# OpenAI alternative: set LLM_PROVIDER=openai and provide OPENAI_API_KEY.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-3.5-turbo

# ASR_PROVIDER: whisper, alibaba. Whisper model downloads need network access.
ASR_PROVIDER=whisper
WHISPER_MODEL=base
# auto selects CUDA when available, otherwise CPU; cuda resolves to the current cuda:N.
# Explicit devices: cpu, cuda, cuda:N (non-negative index).
# MPS is unsupported by the current Whisper/PyTorch runtime; use cpu or auto.
WHISPER_DEVICE=auto
# en is the English-practice default; zh selects Chinese, auto detects the language.
WHISPER_LANGUAGE=en
# Each adapter owns an LRU model cache keyed by model size and resolved device.
# Integer range: 1..4 models per adapter (default 1); eviction releases its reference.
# One lock covers model loading and inference: only one inference per adapter at a time.
WHISPER_MAX_CACHED_MODELS=1
# Optional Aliyun NLS ASR: also requires the alibabacloud-nls-python-sdk package.
# Set ASR_PROVIDER=alibaba, application key, and either token or access key pair.
# ALIYUN_ASR_APP_KEY=
# ALIYUN_ASR_TOKEN=
# ALIYUN_ASR_ACCESS_KEY_ID=
# ALIYUN_ASR_ACCESS_KEY_SECRET=
# Legacy ASR access key fallback: ALIBABA_API_KEY + ALIBABA_API_SECRET.
# ALIBABA_API_SECRET=

# TTS_PROVIDER: edge, alibaba. Both use online services.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
# Alibaba CosyVoice uses DASHSCOPE_API_KEY (or legacy ALIBABA_API_KEY).
ALIBABA_TTS_VOICE=longxiaochun
ALIBABA_TTS_VOLUME=50
ALIBABA_TTS_SPEECH_RATE=1.0
ALIBABA_TTS_PITCH_RATE=1.0
# Rates are multipliers in [0.5, 2.0], volume is an integer in [0, 100].
# Current adapter stores volume/rates but only sends model/voice to the SDK.

# Audio and filesystem paths (relative to the application's working directory).
AUDIO_SAMPLE_RATE=16000
AUDIO_TEMP_DIR=temp_audio
AUDIO_MAX_DURATION=300
CACHE_DIR=.cache
MODEL_CACHE_DIR=data/models

# Gradio ChatService settings; enhanced chat preferences use a separate JSON file.
MAX_HISTORY_LENGTH=20
SESSION_TIMEOUT=3600
# SYSTEM_PROMPT="You are a friendly English conversation coach."

# Optional Gradio interface (API 8010 and frontend 3010 have their own launch config).
GRADIO_SHARE=false
GRADIO_PORT=7860
GRADIO_SERVER_NAME=127.0.0.1

# Logging and runtime mode.
LOG_LEVEL=INFO
LOG_FILE=logs/chatterpal.log
DEBUG=false
ENVIRONMENT=development
